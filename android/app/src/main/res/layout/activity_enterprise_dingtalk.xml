<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/dingtalk_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="16dp"
            android:text="@string/enterprise_login_connecting"
            android:textAppearance="?attr/textAppearanceBodyMedium" />

        <Button
            android:id="@+id/dingtalk_web_login"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            android:text="@string/enterprise_dingtalk_web_login"
            android:visibility="gone" />

        <WebView
            android:id="@id/dingtalk_web"
            android:layout_width="match_parent"
            android:layout_height="480dp"
            android:visibility="gone" />

        <TextView
            android:id="@id/dingtalk_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="16dp"
            android:text="@string/enterprise_dingtalk_failed"
            android:textColor="#B3261E"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:visibility="gone" />

        <Button
            android:id="@id/dingtalk_fallback"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            android:text="@string/enterprise_dingtalk_fallback" />
    </LinearLayout>
</ScrollView>
